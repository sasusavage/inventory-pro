# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/inventory_db

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=True

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# 1. Talk to @BotFather on Telegram → /newbot → copy the token below
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat" → "id" — that is your TELEGRAM_CHAT_ID
# 3. After deploying, register the webhook:
#    POST /telegram/set-webhook  { "url": "https://yourdomain.com" }
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
# Optional — random string to verify webhook calls (recommended for production)
TELEGRAM_WEBHOOK_SECRET=change-this-to-a-random-secret
